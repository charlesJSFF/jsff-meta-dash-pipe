# Meta Graph API long-lived system user token, used to authenticate all Graph API requests.
SYSTEM_USER_TOKEN=your-system-user-token-here

# Facebook Page ID to extract data for.
FB_PAGE_ID=your-facebook-page-id-here

# Instagram Business/Creator account ID linked to the Facebook Page above.
IG_USER_ID=your-instagram-user-id-here

# Ad account ID (format: act_<id>) used to scope Ads Insights. Optional: auto-discovered
# from the API if unset, and only needs to be set to disambiguate multiple linked ad accounts.
AD_ACCOUNT_ID=your-ad-account-id-here
